# ============================================================
# EDP – Production Environment
# Copier en .env.production et remplir toutes les valeurs.
# NE JAMAIS commiter .env.production
# ============================================================

NODE_ENV=production
APP_NAME=EDP
APP_URL=https://edp.app
API_URL=https://api.edp.app
PORT=4000

# ── Base de données ──────────────────────────────────────────
# Format : postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://edp_user:CHANGE_ME@edp-postgres:5432/edp_db
POSTGRES_USER=edp_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=edp_db

# ── Cache Redis ──────────────────────────────────────────────
REDIS_URL=redis://edp-redis:6379
# Optionnel : mot de passe Redis
# REDIS_PASSWORD=CHANGE_ME

# ── JWT (générer avec : openssl rand -hex 32) ────────────────
JWT_SECRET=CHANGE_ME_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# ── OAuth Google ─────────────────────────────────────────────
# https://console.cloud.google.com/ → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth Apple ──────────────────────────────────────────────
# https://developer.apple.com/account/resources/identifiers
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── OAuth Facebook ───────────────────────────────────────────
# https://developers.facebook.com/apps/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── AWS S3 (stockage médias) ─────────────────────────────────
# Créer un bucket S3 + IAM user avec politique PutObject/GetObject
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=eu-west-1
AWS_S3_BUCKET=edp-media-production

# ── Stripe (paiements) ───────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PREMIUM_PRICE_ID=price_CHANGE_ME

# ── Firebase (push notifications) ───────────────────────────
# https://console.firebase.google.com/ → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── Google Maps ──────────────────────────────────────────────
# https://console.cloud.google.com/ → APIs → Maps JavaScript API
GOOGLE_MAPS_API_KEY=

# ── Email (SMTP) ─────────────────────────────────────────────
# Ex: Resend, Postmark, SES
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=CHANGE_ME
SMTP_FROM=noreply@edp.app

# ── Variables publiques Next.js ──────────────────────────────
NEXT_PUBLIC_API_URL=https://api.edp.app
NEXT_PUBLIC_APP_URL=https://edp.app
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
