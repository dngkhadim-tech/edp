# NE PAS COMMITER ce fichier avec de vraies valeurs.
# Créer le secret manuellement ou via un secret manager (AWS Secrets Manager, Vault).
#
# Commande pour créer via kubectl :
#   kubectl create secret generic edp-secrets --from-env-file=.env.production -n edp
#
# Ou appliquer ce fichier après avoir encodé les valeurs en base64 :
#   echo -n "valeur" | base64
apiVersion: v1
kind: Secret
metadata:
  name: edp-secrets
  namespace: edp
type: Opaque
stringData:
  DATABASE_URL: "postgresql://edp_user:CHANGE_ME@edp-postgres:5432/edp_db"
  JWT_SECRET: "CHANGE_ME_32_chars_minimum"
  JWT_REFRESH_SECRET: "CHANGE_ME_32_chars_minimum"
  GOOGLE_CLIENT_ID: ""
  GOOGLE_CLIENT_SECRET: ""
  APPLE_CLIENT_ID: ""
  APPLE_TEAM_ID: ""
  APPLE_KEY_ID: ""
  APPLE_PRIVATE_KEY: ""
  FACEBOOK_APP_ID: ""
  FACEBOOK_APP_SECRET: ""
  AWS_ACCESS_KEY_ID: "CHANGE_ME"
  AWS_SECRET_ACCESS_KEY: "CHANGE_ME"
  STRIPE_SECRET_KEY: "sk_live_CHANGE_ME"
  STRIPE_WEBHOOK_SECRET: "whsec_CHANGE_ME"
  STRIPE_PREMIUM_PRICE_ID: "price_CHANGE_ME"
  FIREBASE_PROJECT_ID: ""
  FIREBASE_PRIVATE_KEY: ""
  FIREBASE_CLIENT_EMAIL: ""
  GOOGLE_MAPS_API_KEY: ""
  SMTP_HOST: ""
  SMTP_PORT: "587"
  SMTP_USER: ""
  SMTP_PASS: ""
  NEXT_PUBLIC_GOOGLE_CLIENT_ID: ""
  NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: ""
  NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY: "pk_live_CHANGE_ME"
  NEXT_PUBLIC_FIREBASE_API_KEY: ""
  NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN: ""
  NEXT_PUBLIC_FIREBASE_PROJECT_ID: ""
  NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID: ""
  NEXT_PUBLIC_FIREBASE_APP_ID: ""
